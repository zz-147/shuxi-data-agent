# 运行模式：mock（离线演示，默认）| dashscope（真实调用通义千问）
SHUXI_PROVIDER=mock

# 通义千问 DashScope（OpenAI 兼容模式）
DASHSCOPE_API_KEY=sk-your-key
SHUXI_MODEL=qwen-plus
SHUXI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 数据与日志
SHUXI_DB_PATH=data/demo.db
SHUXI_LOG_DIR=logs

# 安全策略
SHUXI_AUTO_APPROVE=false
SHUXI_MAX_STEPS=8
SHUXI_QUERY_ROW_LIMIT=200
